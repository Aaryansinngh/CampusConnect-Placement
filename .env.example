# CampusConnect Placement - Environment Configuration Example

# ==============================================================================
# ENVIRONMENT & GENERAL SETTINGS
# ==============================================================================
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=replace_with_a_secure_random_secret_key_min_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==============================================================================
# DATABASE (PostgreSQL)
# ==============================================================================
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=your_database_name

DATABASE_URL=postgresql+asyncpg://your_user:your_password@localhost:5432/your_database
DATABASE_URL_SYNC=postgresql://your_user:your_password@localhost:5432/your_database

# ==============================================================================
# CORS & FRONTEND CLIENTS
# ==============================================================================
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ==============================================================================
# CLOUDINARY (Resumes, Offer Letters & Document Storage)
# ==============================================================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ==============================================================================
# FIREBASE CLOUD MESSAGING (FCM Push Notifications)
# ==============================================================================
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

# ==============================================================================
# SUPER ADMIN / INITIAL SEED CREDENTIALS
# ==============================================================================
FIRST_SUPER_ADMIN_EMAIL=your_super_admin_email
FIRST_SUPER_ADMIN_PASSWORD=replace_with_secure_super_admin_password

FIRST_TPO_EMAIL=your_tpo_email
FIRST_TPO_PASSWORD=replace_with_secure_tpo_password