rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isTpoAdmin() {
      return isAuthenticated() && (
        getUserData().role == 'TPO_ADMIN' ||
        getUserData().role == 'SUPER_ADMIN' ||
        getUserData().role == 'CLUB_ADMIN'
      );
    }

    function isRecruiter() {
      return isAuthenticated() && getUserData().role == 'RECRUITER';
    }

    // 1. Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isTpoAdmin();
      allow delete: if isTpoAdmin();
    }

    // 2. Students collection
    match /students/{studentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == studentId;
      allow update: if isOwner(studentId) || isTpoAdmin();
      allow delete: if isTpoAdmin();
    }

    // 3. Academic Records (Verified institutional data)
    match /academic_records/{recordId} {
      allow read: if isAuthenticated() && (request.auth.uid == recordId || isTpoAdmin() || isRecruiter());
      allow write: if isTpoAdmin();
    }

    // 4. Recruiters collection
    match /recruiters/{recruiterId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(recruiterId) || isTpoAdmin();
    }

    // 5. Placement Drives
    match /placement_drives/{driveId} {
      allow read: if isAuthenticated();
      allow create: if isRecruiter() || isTpoAdmin();
      allow update, delete: if isRecruiter() || isTpoAdmin();
    }

    // 6. Applications collection
    match /applications/{applicationId} {
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid || isTpoAdmin() || isRecruiter()
      );
      allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid || isRecruiter() || isTpoAdmin()
      );
      allow delete: if isTpoAdmin();
    }

    // 7. Resumes metadata
    match /resumes/{resumeId} {
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid || isRecruiter() || isTpoAdmin()
      );
      allow write: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
    }

    // 8. Notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if isAuthenticated();
    }

    // 9. Approvals & Administrative decisions
    match /approvals/{approvalId} {
      allow read: if isAuthenticated();
      allow write: if isTpoAdmin();
    }
  }
}
